generator client {
  provider = "prisma-client"
  output   = "./generated"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

model FormSubmission {
  id          Int              @id @default(autoincrement())
  name        String           // Имя, фамилия (обязательное)
  phone       String           // Телефон (обязательное)
  email       String           // Email (обязательный)
  message     String           // Сообщение или вопрос (обязательное)
  consent     Boolean          // Согласие на обработку ПД (обязательное)
  files       Json?            // Legacy: старые заявки до SubmissionFile
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments SubmissionFile[]
}

model SubmissionFile {
  id           Int            @id @default(autoincrement())
  submissionId Int
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalName String         // Имя файла от пользователя
  storedName   String         @unique // Уникальное символьное имя на диске и в URL
  storagePath  String         // Относительный путь в uploads/
  mimeType     String         @default("application/octet-stream")
  size         Int            @default(0)
  createdAt    DateTime       @default(now())

  @@index([submissionId])
}