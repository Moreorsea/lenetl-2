generator client {
  provider = "prisma-client"
  output   = "./generated"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum SubmissionStatus {
  NEW
  WAITING_CLARIFICATION
  PROCESSED
  CLOSED
}

model FormSubmission {
  id          Int              @id @default(autoincrement())
  name        String           // Имя, фамилия (обязательное)
  phone       String           // Телефон (обязательное)
  email       String           // Email (обязательный)
  message     String           // Сообщение или вопрос (обязательное)
  consent     Boolean          // Согласие на обработку ПД (обязательное)
  status      SubmissionStatus @default(NEW)
  managerComment String?          @db.Text
  deletedAt   DateTime?
  files       Json?            // Legacy: старые заявки до SubmissionFile
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments SubmissionFile[]

  @@index([deletedAt])
  @@index([status])
}

model SubmissionHistory {
  id                   Int              @id @default(autoincrement())
  originalSubmissionId Int
  name                 String
  phone                String
  email                String
  message              String
  consent              Boolean
  status               SubmissionStatus
  managerComment       String?          @db.Text
  filesCount           Int              @default(0)
  submittedAt          DateTime
  deletedAt            DateTime
  archivedAt           DateTime         @default(now())

  @@index([archivedAt])
  @@index([originalSubmissionId])
}

model SubmissionFile {
  id           Int            @id @default(autoincrement())
  submissionId Int
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalName String         // Имя файла от пользователя
  storedName   String         @unique // Уникальное символьное имя на диске и в URL
  storagePath  String         // Относительный путь в uploads/
  mimeType     String         @default("application/octet-stream")
  size         Int            @default(0)
  createdAt    DateTime       @default(now())

  @@index([submissionId])
}